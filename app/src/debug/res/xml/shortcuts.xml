<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build copy of main/res/xml/shortcuts.xml: targetPackage must match the debug applicationId -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add_expense"
        android:shortcutShortLabel="@string/shortcut_add_expense_short"
        android:shortcutLongLabel="@string/shortcut_add_expense_long"
        android:shortcutDisabledMessage="@string/shortcut_add_expense_disabled">
        <!-- Same entry point as the Quick Settings tile (MainActivity.ACTION_ADD_EXPENSE) -->
        <intent
            android:action="com.guruprasad.mngexpense.action.ADD_EXPENSE"
            android:targetClass="com.guruprasad.mngexpense.MainActivity"
            android:targetPackage="com.guruprasad.mngexpense.debug" />
    </shortcut>
</shortcuts>
