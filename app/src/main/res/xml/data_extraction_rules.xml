<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own cloud backup and device-to-device transfer, Android 12+.
     See https://developer.android.com/about/versions/12/backup-restore -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Restored on a new install, it would hide the "Restore your backup?" question -->
        <exclude domain="sharedpref" path="backup_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="backup_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
