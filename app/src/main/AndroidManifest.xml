<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/college"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/college"
        android:supportsRtl="true"
        android:theme="@style/Theme.CollegeApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".Activities.Principle.Deadlines.AddDeadlineActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Office.AddBudgetActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Office.ShowBudgetActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Principle.Deadlines.ShowDeadlineActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Principle.Attendance.ShowAttendanceReportActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Principle.WorkLoad.ShowWorkLoadReportActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Attendance.AddAttendanceActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Attendance.ShowAttendanceActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Notes.AddNotesActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Notes.ShowNotesActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Workload.ShowWorkLoadActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Notice.AddNoticeActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Principle.Notice.AddPrincipleNotice"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Assignment.AddAssignmentActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Assignment.ShowAssignmentActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.SpreadSheet.ShowSpreadSheetActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.Workload.AddWorkLoadReport"
            android:exported="false" />
        <activity
            android:name=".Activities.Faculty.SpreadSheet.SpreadSheetActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.HomeActivity"
            android:exported="false"
            android:label="@string/title_activity_home"
            android:theme="@style/Theme.CollegeApp.NoActionBar" />
        <activity
            android:name=".Auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".Auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".Constants.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>